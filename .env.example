# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# Self-hosted gateway (OpenAI-compatible: LiteLLM, vLLM, LM Studio, ...).
# This is the default path: nothing leaves your network.
COMPANY_API_URL=https://your-gateway:8443
COMPANY_API_KEY=
COMPANY_LLM_MODEL=gpt-oss

# Optional: a separate multimodal model for OCR of scanned pages.
# Without one, use --ocr tesseract to transcribe on this machine.
# DOCROUTER_LOCAL_VISION_MODEL=

# Only needed for --backend llm / --ocr claude, which send data off-network.
# ANTHROPIC_API_KEY=sk-ant-...
